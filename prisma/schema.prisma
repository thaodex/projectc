generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  admin
  viewer
}

enum KeyStatus {
  active
  suspended
  revoked
  expired
}

enum DeviceStatus {
  active
  revoked
}

enum AlertSeverity {
  medium
  high
  critical
}

enum AlertStatus {
  open
  investigating
  resolved
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(admin)
  totpSecret   String?  @map("totp_secret")
  createdAt    DateTime @default(now()) @map("created_at")
  keysCreated  LicenseKey[] @relation("CreatedBy")
  auditLogs    AuditLog[] @relation("Actor")
  @@map("users")
}

model Product {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  bundleId       String?      @unique @map("bundle_id")
  currentVersion String       @map("current_version")
  note           String?
  createdAt      DateTime     @default(now()) @map("created_at")
  licenseKeys    LicenseKey[]
  devices        Device[]
  @@map("products")
}

model LicenseKey {
  id           String    @id @default(cuid())
  keyCode      String    @unique @map("key_code")
  productId    String    @map("product_id")
  ownerName    String    @map("owner_name")
  ownerEmail   String    @map("owner_email")
  maxDevices   Int       @default(1) @map("max_devices")
  deviceCount  Int       @default(0) @map("device_count")
  revision     Int       @default(1)
  status       KeyStatus @default(active)
  plan         String
  expiresAt    DateTime? @map("expires_at")
  note         String?
  createdById  String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  product      Product   @relation(fields: [productId], references: [id])
  createdBy    User?     @relation("CreatedBy", fields: [createdById], references: [id])
  devices      Device[]
  commands     DeviceCommand[]
  alerts       SecurityAlert[]
  auditLogs    AuditLog[]
  @@index([status])
  @@map("license_keys")
}

model Device {
  id          String       @id @default(cuid())
  keyId       String       @map("key_id")
  productId   String       @map("product_id")
  // HMAC(UDID/UID, server pepper); unique within each app/Product, never stored raw.
  uidHash     String       @map("uid_hash")
  uidDisplay  String       @map("uid_display")
  deviceName  String       @map("device_name")
  platform    String
  osVersion   String?      @map("os_version")
  appVersion  String?      @map("app_version")
  ipFirst     String?      @map("ip_first")
  ipLast      String?      @map("ip_last")
  country     String?
  apnsToken   String?      @unique @map("apns_token")
  apnsUpdatedAt DateTime?  @map("apns_updated_at")
  status      DeviceStatus @default(active)
  activatedAt DateTime     @default(now()) @map("activated_at")
  lastSeenAt  DateTime     @default(now()) @map("last_seen_at")
  key         LicenseKey   @relation(fields: [keyId], references: [id], onDelete: Restrict)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  commands    DeviceCommand[]
  @@unique([productId, uidHash])
  @@index([keyId, lastSeenAt])
  @@map("devices")
}

model DeviceEnrollment {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @map("token_hash")
  uidHash    String?   @map("uid_hash")
  uidDisplay String?   @map("uid_display")
  source     String    @default("udid_profile")
  verifiedAt DateTime? @map("verified_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  @@index([uidHash, expiresAt])
  @@map("device_enrollments")
}

model DeviceCommand {
  id          String      @id @default(cuid())
  keyId       String      @map("key_id")
  deviceId    String      @map("device_id")
  revision    Int
  type        String
  payload     Json?
  deliveredAt DateTime?   @map("delivered_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  key         LicenseKey  @relation(fields: [keyId], references: [id], onDelete: Cascade)
  device      Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  @@index([deviceId, acknowledgedAt, revision])
  @@map("device_commands")
}

model AuditLog {
  id        String      @id @default(cuid())
  actorId   String?     @map("actor_id")
  action    String
  keyId     String?     @map("key_id")
  deviceId  String?     @map("device_id")
  ip        String?
  userAgent String?     @map("user_agent")
  payload   Json?
  createdAt DateTime    @default(now()) @map("created_at")
  actor     User?       @relation("Actor", fields: [actorId], references: [id])
  key       LicenseKey? @relation(fields: [keyId], references: [id])
  @@index([createdAt])
  @@map("audit_logs")
}

model ApiNonce {
  id        String   @id @default(cuid())
  value     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([expiresAt])
  @@map("api_nonces")
}

model SecurityAlert {
  id        String        @id @default(cuid())
  keyId     String        @map("key_id")
  severity  AlertSeverity
  title     String
  detail    String
  signals   Json
  status    AlertStatus   @default(open)
  createdAt DateTime      @default(now()) @map("created_at")
  key       LicenseKey    @relation(fields: [keyId], references: [id], onDelete: Cascade)
  @@index([keyId, status])
  @@map("security_alerts")
}
